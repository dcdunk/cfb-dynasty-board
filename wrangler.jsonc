{
  // Static site: everything in ./public is served as-is. The Worker (src/worker.js) runs first only for /api/*,
  // which is Coach's AI understanding step, so every page, script and data request stays a free static-asset request.
  // www.cfbdynastyboard.com -> cfbdynastyboard.com is a Redirect Rule in the Cloudflare dashboard (Rules > Redirect Rules), not code.
  // The www custom domain stays attached so www keeps a proxied DNS record for that rule to act on.
  "name": "cfb-dynasty-board",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.js",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Workers AI on the free plan: 10,000 neurons/day, about 1,100 Coach messages. Past that, calls fail and Coach falls back to keywords.
  "ai": { "binding": "AI" },
  // Per visitor (IP): 20 Coach AI calls a minute.
  "ratelimits": [{ "name": "COACH_RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "routes": [
    { "pattern": "cfbdynastyboard.com", "custom_domain": true },
    { "pattern": "www.cfbdynastyboard.com", "custom_domain": true }
  ]
}
